__pycache__/
*.pyc
.venv/
.venv_pyradiomics/
venv/
.ruff_cache/

# Office lock files
~$*

# Foundation-model weights (705 MB; fmcib.torch from Pai et al. 2024, placed here by hand)
models/

# Per-patient caches and temporary crops of the external cohorts (regenerable)
data/external/**/cache/
data/external/**/tmp/
data/external/**/crops/

# Downloaded DICOM series and derived image volumes are large and
# reproducible from data/raw/ + src/nsclc_pipeline/download.py -- don't track.
data/interim/
data/processed/masks/
*.dcm
*.nii
*.nii.gz

# Fetched from GEO (external to the TCIA bundle), regenerable via
# src/nsclc_pipeline/rna_seq.py -- don't track the raw or derived copies.
data/raw/GSE103584_R01_NSCLC_RNAseq.txt.gz
data/processed/rna_seq_expression.csv.gz

# PyRadiomics source used to build .venv_pyradiomics
.pyradiomics_src/

# Figures and other generated files; the pipeline recreates outputs/ on a fresh clone
outputs/
# Manuscript files are kept outside this repository
paper/

# Run logs of the download and extraction steps
*.log

# Packaging
*.egg-info/
build/
dist/

# Foundation-model features of LIDC-IDRI (202 MB, over GitHub's file limit;
# regenerated by scripts/data/lidc_fm_features.py from the public model weights)
data/external/lidc/lidc_fm_features.csv
# Downloaded image series of the external cohorts (DICOM files are ignored above;
# also ignore the per-patient folders themselves)
data/external/lung1/LUNG1-*/
